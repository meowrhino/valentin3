// La copia de Valentín, en Cloudflare: Workers Builds conectado a su repo.
// El build escribe dist/ y se publica eso, en la raíz, con el dominio de
// data/site.json → "url". Una dirección que no existe sirve el 404 (la home).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web",
  "compatibility_date": "2026-05-05",
  "build": { "command": "node build/build.mjs" },
  "assets": { "directory": "./dist", "not_found_handling": "404-page" }
}
